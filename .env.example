# Copia este archivo a .env y rellena los datos REALES de cada persona.
# El buzón es lo único desechable; nombre, apellido y fecha van de verdad.

# --- Persona 1: tú ---
ME_FIRST_NAME=
ME_LAST_NAME=
# Formato AAAA-MM-DD
ME_BIRTH_DATE=
# Opcional: solo se usa si algún formulario lo pide
ME_PHONE=

# --- Persona 2: tu pareja ---
PARTNER_FIRST_NAME=
PARTNER_LAST_NAME=
PARTNER_BIRTH_DATE=
PARTNER_PHONE=

# Contraseña final de las dos cuentas
BF_PASSWORD=12345678Aa.

# audit = rellena y para antes de enviar | live = envía de verdad
MODE=audit

# Espera máxima del correo (el segundo puede tardar)
MAIL_WAIT_MINUTES=20

# Espera máxima si salta un reto anti-bot (se resuelve a mano en la ventana)
CHALLENGE_WAIT_MINUTES=5

# Opcionales
# SIGNUP_URL=https://member.basic-fit.com/es-ES/signup/BlackFriday_FitTogether
# REGISTER_URL=https://login.basic-fit.com/register
# MAIL_DOMAIN=fldubai.com
