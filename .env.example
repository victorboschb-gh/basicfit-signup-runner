# Copia este archivo a .env y rellena los datos REALES de cada persona.
# El buzón es lo único desechable; nombre, apellido y fecha van de verdad.

# --- Persona 1: tú ---
ME_FIRST_NAME=
ME_LAST_NAME=
# Formato AAAA-MM-DD
ME_BIRTH_DATE=
# Opcional: solo se usa si algún formulario lo pide
ME_PHONE=

# --- Persona 2: tu pareja ---
PARTNER_FIRST_NAME=
PARTNER_LAST_NAME=
PARTNER_BIRTH_DATE=
PARTNER_PHONE=

# Contraseña final de las dos cuentas
BF_PASSWORD=12345678Aa.

# audit = rellena y para antes de enviar | live = envía de verdad
MODE=audit

# Espera máxima del correo (el segundo puede tardar)
MAIL_WAIT_MINUTES=25

# Espera máxima si salta un reto anti-bot (se resuelve a mano en la ventana)
CHALLENGE_WAIT_MINUTES=5

# Opcionales
# SIGNUP_URL=https://member.basic-fit.com/es-ES/signup/BlackFriday_FitTogether
# REGISTER_URL=https://login.basic-fit.com/register
# MAIL_DOMAIN=fldubai.com

# --- Navegador (Camoufox, Firefox anti-detección) ---
# 1 = oculta la ventana (por defecto se muestra).
# CAMOUFOX_HEADLESS=0
# 1 = ajusta zona horaria, idioma y WebRTC a la IP de salida (recomendado en VPS).
# CAMOUFOX_GEOIP=0
# 1 = desactiva el sandbox de Firefox (contenedores como root).
# PLAYWRIGHT_NO_SANDBOX=1
# Espera tras el alta antes de pedir la contraseña (segundos).
# SIGNUP_SETTLE_SECONDS=180
# Espera antes de reintentar el registro si salta el anti-bot (segundos).
# REGISTER_RETRY_SECONDS=180
# Proxy opcional (recomendado residencial español si el VPS está marcado).
# PROXY_SERVER=http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
