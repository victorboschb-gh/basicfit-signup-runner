# Variables del servidor HTTP (NO las metas en git).
# En EasyPanel se pegan en la pestaña Environment del servicio.

# Obligatorio: mínimo 24 caracteres. Se usa como Bearer token.
API_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

PORT=8787
BIND=0.0.0.0

# Tiempo máximo por job (los correos pueden tardar)
JOB_TIMEOUT_MINUTES=60
MAIL_WAIT_MINUTES=25
CHALLENGE_WAIT_MINUTES=5

# Contenedor como root: desactiva el sandbox de Firefox
PLAYWRIGHT_NO_SANDBOX=1

# Camoufox: 1 = navegador oculto; 1 = zona horaria/idioma/WebRTC según IP de salida
# CAMOUFOX_HEADLESS=0
# CAMOUFOX_GEOIP=1

# Espera tras el alta y reintento del registro si Check Point bloquea
SIGNUP_SETTLE_SECONDS=180
REGISTER_RETRY_SECONDS=180

# Proxy opcional (residencial español si el VPS está bloqueado)
# PROXY_SERVER=http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=

BF_PASSWORD=12345678Aa.

# Datos reales de cada persona (si están vacíos, el job falla con error claro)
ME_FIRST_NAME=
ME_LAST_NAME=
ME_BIRTH_DATE=
ME_PHONE=

PARTNER_FIRST_NAME=
PARTNER_LAST_NAME=
PARTNER_BIRTH_DATE=
PARTNER_PHONE=
